# Copiar como .env.local (en tu PC) o cargar en el panel del hosting.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys (anon/publishable y service_role/secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > Credenciales de PRUEBA (Access Token)
# MP_WEBHOOK_SECRET = "Firma secreta" de Webhooks (evento "Pagos")
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# "prueba" o "produccion". En prueba solo se aceptan pagos de prueba.
MP_MODO=prueba

# Libro A · Electricidad práctica para el hogar (amarillo)
PRECIO_ARS=9900
PRECIO_REGULAR_ARS=14900
GUIA_PAGINAS=0

# Libro B · Camino al electricista. Mientras LIBRO_B_DISPONIBLE no sea "si", se muestra "Próximamente".
LIBRO_B_DISPONIBLE=no
LIBRO_B_PAGINAS=0
LIBRO_B_PRECIO_ARS=14900
LIBRO_B_PRECIO_REGULAR_ARS=19900
# Precio del B para quien ya compró el A
LIBRO_B_PRECIO_CON_A_ARS=9900
# Pack A + B (se ofrece solo cuando el B está disponible)
PACK_PRECIO_ARS=19900

# Datos del vendedor (se muestran en el pie, términos y privacidad)
VENDEDOR_NOMBRE=
VENDEDOR_CUIT=
VENDEDOR_DOMICILIO=
VENDEDOR_EMAIL=
