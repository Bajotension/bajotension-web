# Copiar como .env.local (en tu PC) o cargar en el panel del hosting.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys (anon/publishable y service_role/secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > Credenciales de PRUEBA
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# "prueba" o "produccion". En prueba solo se aceptan pagos de prueba.
MP_MODO=prueba

# Producto
PRECIO_ARS=9900
PRECIO_REGULAR_ARS=14900
GUIA_PAGINAS=0

# Datos del vendedor (se muestran en el pie, términos y privacidad)
VENDEDOR_NOMBRE=
VENDEDOR_CUIT=
VENDEDOR_DOMICILIO=
VENDEDOR_EMAIL=
